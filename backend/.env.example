# Copy to .env — never commit real secrets.
#
# Vercel: use the same Mongo settings as when you run `npm run create-admin`.
# If MONGODB_URI is set, it overrides MONGODB_USER / MONGODB_PASSWORD / MONGODB_HOST / MONGODB_DB.

# Option A — full URI (password must be URL-encoded inside the string).
# MONGODB_URI=mongodb+srv://USER:ENCODED_PASSWORD@cluster0.xxxxx.mongodb.net/kutagjej?retryWrites=true&w=majority

# Option B — plain password; no manual encoding.
# MONGODB_USER=myuser
# MONGODB_PASSWORD=your_plain_password_here
# MONGODB_HOST=cluster0.xxxxx.mongodb.net
# MONGODB_DB=kutagjej

MONGODB_URI=

# Required for /api/auth/login and protected routes (any long random string).
# Must be set on Vercel for the API project (not only Mongo vars). If missing, login returns 500.
JWT_SECRET=

PORT=5000
