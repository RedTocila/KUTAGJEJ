# Copy to backend/.env (never commit secrets).

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: keep Auto-Refresh off to avoid scheduled processing and add-on sales.
# Set to true only when the feature is ready to be enabled again.
AUTO_REFRESH_ENABLED=false

# Resend — branded auth emails (confirm, reset password, password changed).
# Verify kutagjej.al in Resend, then keep this From address.
RESEND_API_KEY=
RESEND_FROM=KuTaGjej <noreply@kutagjej.al>

# Optional: Supabase Auth → Send Email Hook
# Dashboard: Authentication → Hooks → Send Email
# URL: https://<api-host>/api/auth/hooks/send-email
# Paste the hook secret here (v1,whsec_…).
SUPABASE_SEND_EMAIL_HOOK_SECRET=

# Branded HTML for Dashboard → Authentication → Email Templates:
#   supabase/email-templates/  (see COPY-INTO-SUPABASE.txt)
