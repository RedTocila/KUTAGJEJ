# Copy to .env — never commit real secrets.
# Create a project at https://supabase.com → Settings → API

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# service_role secret — server only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Optional Postgres URL (Settings → Database) for CLI DDL repairs:
#   DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@…pooler.supabase.com:6543/postgres
#   node scripts/repair-db.js

# Public site URL for referral / payment redirects (no trailing slash).
FRONTEND_URL=http://localhost:3000

# CORS_EXTRA_ORIGINS=
# CORS_ALLOW_VERCEL_PREVIEWS=true

# Optional image uploads (Vercel Blob)
# BLOB_READ_WRITE_TOKEN=

# --- POK Payments (https://docs.pokpay.io) ---
POK_ENV=production
POK_MERCHANT_ID=
POK_KEY_ID=
POK_KEY_SECRET=

# OpenAI (https://platform.openai.com) — server only
# OPENAI_API_KEY=
