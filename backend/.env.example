# Copy to .env — never commit real secrets.
#
# Create a project at https://supabase.com → Settings → API

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# service_role secret — server only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL for referral invite links (no trailing slash).
# FRONTEND_URL=http://localhost:3000

# CORS_EXTRA_ORIGINS=
# CORS_ALLOW_VERCEL_PREVIEWS=false

# --- POK Payments (https://docs.pokpay.io) ---
POK_ENV=production
POK_MERCHANT_ID=
POK_KEY_ID=
POK_KEY_SECRET=
