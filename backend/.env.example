# Copy to backend/.env (never commit secrets).

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: keep Auto-Refresh off to avoid scheduled processing and add-on sales.
# Set to true only when the feature is ready to be enabled again.
AUTO_REFRESH_ENABLED=false

# Resend — branded auth emails (confirm, reset password, password changed).
# REQUIRED in production. Without this, signup succeeds but no inbox mail is sent.
# Accepts RESEND_API_KEY or RESEND_API (Vercel currently has RESEND_API).
# Verify kutagjej.al in Resend, then keep this From address.
RESEND_API_KEY=
# RESEND_API=
RESEND_FROM=KuTaGjej <noreply@kutagjej.al>

# Optional: Supabase Auth → Send Email Hook (ACK-first branded mail for Auth-triggered sends).
# If enabled, URL must be reachable: https://<api-host>/api/auth/hooks/send-email
# Paste the hook secret here (v1,whsec_…). Leave empty if the hook is disabled.
SUPABASE_SEND_EMAIL_HOOK_SECRET=

# Branded HTML for Dashboard → Authentication → Email Templates:
#   supabase/email-templates/  (see COPY-INTO-SUPABASE.txt)

# RevenueCat → Integrations → Webhooks
# URL: https://www.kutagjej.al/api/webhooks/revenuecat
# Authorization header must equal this value (or Bearer <value>).
REVENUECAT_WEBHOOK_SECRET=

# Apple push (iOS app only). All three are required or sends are skipped.
# APNS_KEY_P8 is the .p8 file contents. Use \n for line breaks if the value is one line.
# APNS_ENV=sandbox for Xcode debug builds; omit for production (TestFlight / App Store).
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
# APNS_BUNDLE_ID=al.kutagjej.app
# APNS_ENV=production
