require_relative '../../node_modules/@capacitor/ios/scripts/pods_helpers'

# Xcode 27+ MinimumDeploymentTarget is 15.0 — 14.0 fails for all pods
platform :ios, '15.0'
use_frameworks! :linkage => :static

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorApp', :path => '../../node_modules/@capacitor/app'
  pod 'CapacitorBrowser', :path => '../../node_modules/@capacitor/browser'
  pod 'CapacitorCamera', :path => '../../node_modules/@capacitor/camera'
  pod 'CapacitorNetwork', :path => '../../node_modules/@capacitor/network'
  pod 'CapacitorPushNotifications', :path => '../../node_modules/@capacitor/push-notifications'
  pod 'CapacitorShare', :path => '../../node_modules/@capacitor/share'
  pod 'CapacitorSplashScreen', :path => '../../node_modules/@capacitor/splash-screen'
  pod 'CapacitorStatusBar', :path => '../../node_modules/@capacitor/status-bar'
  pod 'RevenuecatPurchasesCapacitor', :path => '../../node_modules/@revenuecat/purchases-capacitor'
end

target 'App' do
  capacitor_pods
  # Add your Pods here
end

post_install do |installer|
  assertDeploymentTarget(installer)
  # pod install replaces PurchasesHybridCommon. Re-apply the payment-sheet scene fix if it was wiped.
  hybrid = File.expand_path('Pods/PurchasesHybridCommon/ios/PurchasesHybridCommon/PurchasesHybridCommon/CommonFunctionality.swift', __dir__)
  if File.exist?(hybrid)
    File.chmod(0644, hybrid)
    src = File.read(hybrid)
    src.sub!("import Foundation\n", "import Foundation\nimport UIKit\n") unless src.include?("import UIKit\n")
    updated = <<~'SWIFT'
            // kutagjejConfirmInScene2: StoreKit 2 only presents the payment sheet on the key window's scene, from the main thread.
            let presentAppleSheet = {
                if #available(iOS 17.0, *) {
                    let scenes = UIApplication.shared.connectedScenes.compactMap { $0 as? UIWindowScene }
                    let scene = scenes.first { $0.windows.contains { $0.isKeyWindow } }
                        ?? scenes.first { $0.activationState == .foregroundActive }
                        ?? scenes.first
                    if let scene {
                        if !scene.windows.contains(where: { $0.isKeyWindow }) {
                            scene.windows.first?.makeKeyAndVisible()
                        }
                        let params = PurchaseParams.Builder(product: storeProduct)
                            .with(confirmInScene: scene)
                            .build()
                        Self.sharedInstance.purchase(params, completion: hybridCompletion)
                    } else {
                        Self.sharedInstance.purchase(product: storeProduct, completion: hybridCompletion)
                    }
                } else {
                    Self.sharedInstance.purchase(product: storeProduct, completion: hybridCompletion)
                }
            }
            if Thread.isMainThread {
                presentAppleSheet()
            } else {
                DispatchQueue.main.async(execute: presentAppleSheet)
            }
    SWIFT
    old = <<~'SWIFT'
            // kutagjejConfirmInScene: without the foreground scene, StoreKit 2 never presents the payment sheet and the call never returns.
            if #available(iOS 17.0, *),
               let scene = UIApplication.shared.connectedScenes.compactMap({ $0 as? UIWindowScene }).first(where: { $0.activationState == .foregroundActive })
                           ?? UIApplication.shared.connectedScenes.compactMap({ $0 as? UIWindowScene }).first {
                let params = PurchaseParams.Builder(product: storeProduct)
                    .with(confirmInScene: scene)
                    .build()
                Self.sharedInstance.purchase(params, completion: hybridCompletion)
            } else {
                Self.sharedInstance.purchase(product: storeProduct, completion: hybridCompletion)
            }
    SWIFT
    needle = "            Self.sharedInstance.purchase(product: storeProduct, completion: hybridCompletion)\n"
    if src.include?('kutagjejConfirmInScene:') && !src.include?('kutagjejConfirmInScene2')
      src.gsub!(old, updated)
    elsif !src.include?('kutagjejConfirmInScene2')
      src.gsub!(needle, updated)
    end
    File.write(hybrid, src)
  end
  # Capacitor pods ship with 14.0; bump to Xcode 27's floor
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      deployment_target = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f
      if deployment_target > 0.0 && deployment_target < 15.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end
      # Xcode 16+ explicit modules break Capacitor static frameworks
      config.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'
      config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
      # Pods are regenerated on every install; keep the App Store team or archive signing fails
      config.build_settings['DEVELOPMENT_TEAM'] = '425G4U67A8'
      config.build_settings['CODE_SIGN_STYLE'] = 'Automatic'
    end
  end
end
