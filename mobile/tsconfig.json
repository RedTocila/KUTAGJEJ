{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "allowJs": true,
    "checkJs": false
  },
  "include": ["capacitor.config.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "android", "ios", "www"]
}
