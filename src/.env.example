# Public app always on :3000. Browser uses this (Next proxies /api internally).
NEXT_PUBLIC_API_URL=http://localhost:3000

# Supabase (Settings → API). Anon key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — Google Search Console HTML tag content (GSC → Ownership verification → HTML tag).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# RevenueCat public SDK keys (Capacitor native shell only; web ignores these).
# Dashboard → Project → API Keys → Apple / Google public SDK key.
NEXT_PUBLIC_REVENUECAT_IOS_API_KEY=
# NEXT_PUBLIC_REVENUECAT_ANDROID_API_KEY=
